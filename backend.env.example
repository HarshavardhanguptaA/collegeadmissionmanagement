# Copy these variables into your PowerShell session before starting Spring Boot.
# Replace all values with your own local configuration.
$env:DB_URL = "jdbc:postgresql://localhost:5432/college_admission"
$env:DB_USERNAME = "postgres"
$env:DB_PASSWORD = "REPLACE_WITH_YOUR_POSTGRES_PASSWORD"
$env:APP_JWT_SECRET = "REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG"
$env:APP_ADMIN_EMAIL = "admin@college.local"
$env:APP_ADMIN_PASSWORD = "REPLACE_WITH_A_STRONG_ADMIN_PASSWORD"
$env:APP_ADMIN_NAME = "College Administrator"
